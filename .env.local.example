TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_token_here
RESEND_API_KEY=re_your_key_here
RESEND_AUDIENCE_ID=your-audience-id
ALERT_FROM_EMAIL=alerts@dividendvisual.com
NEWSLETTER_FROM_EMAIL=newsletter@dividendvisual.com
NEWSLETTER_UNSUBSCRIBE_SECRET=use-a-long-random-secret
NEWSLETTER_MAX_DATA_AGE_DAYS=7
INGEST_TICKER_TIMEOUT_SECONDS=90
YFINANCE_REQUEST_TIMEOUT_SECONDS=30
TURSO_REQUEST_TIMEOUT_SECONDS=20
INGEST_MAX_FAILURES=25

# Optional: keep Beehiiv as a secondary subscriber sync.
BEEHIIV_API_KEY=your_beehiiv_key_here
BEEHIIV_PUBLICATION_ID=pub_your_publication_id
